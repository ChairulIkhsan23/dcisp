# Database Configuration (PostgreSQL 16)
DB_HOST=127.0.0.1
DB_PORT=5434
DB_USER=postgres
DB_PASSWORD=postgres_secret_pass
DB_NAME=dcisp_db
DB_SSLMODE=disable

# Redis Configuration (Redis 7)
REDIS_HOST=localhost
REDIS_PORT=6381
REDIS_PASSWORD=

# App Server (Golang Gin)
PORT=8080
GIN_MODE=debug
JWT_SECRET=super_secret_jwt_key_dcisp_2026_32bytes_long!
JWT_ACCESS_DURATION_MINUTES=15
JWT_REFRESH_DURATION_DAYS=7

# Storage Cloudflare R2 (S3-Compatible)
R2_ACCOUNT_ID=local_dev_account
R2_ACCESS_KEY_ID=local_dev_key
R2_SECRET_ACCESS_KEY=local_dev_secret
R2_BUCKET_NAME=dcisp-vault
R2_PUBLIC_URL=https://pub-r2.dcisp.internal
